{
  "expo": {
    "name": "Aviation Job Talent",
    "slug": "aviationjobtalent",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aviationjobtalent",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aviationjobtalent.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1628"
      },
      "package": "com.aviationjobtalent.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
