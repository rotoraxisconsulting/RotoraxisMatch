{
  "name": "aviationjobtalent",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "ts": "tsc --noEmit",
    "test:matching": "tsc --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck --outDir .tmp-test-matching scripts/testMatching.ts && node .tmp-test-matching/scripts/testMatching.js",
    "validate:aircraft-ratings": "tsc --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck --outDir .tmp-validate-aircraft-ratings scripts/validateAircraftTypeRatingsCatalog.ts && node .tmp-validate-aircraft-ratings/scripts/validateAircraftTypeRatingsCatalog.js",
    "backfill:aircraft-ratings": "tsc --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck --outDir .tmp-backfill-aircraft-ratings scripts/backfillLegacyAircraftRatings.ts && node .tmp-backfill-aircraft-ratings/scripts/backfillLegacyAircraftRatings.js",
    "generate:easa-catalog": "tsc --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck --outDir .tmp-generate-easa-catalog scripts/generateEasaFullCatalogMigration.ts && node .tmp-generate-easa-catalog/generateEasaFullCatalogMigration.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.107.0",
    "@types/leaflet": "^1.9.21",
    "expo": "^54.0.34",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react-native": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-native": "^0.81.5",
    "react-native-maps": "^1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
