# ─────────────────────────────────────────────────────────────
# AviationJobTalent — Client environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Supabase project URL (found in Supabase Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable/anon key (same location as above)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# Public base URL used for Supabase auth redirect links (password reset, email confirmation).
# Development:  http://localhost:8081
# PRODUCTION:   change to your deployed web URL before going live
#               e.g. https://app.aviationjobtalent.com
EXPO_PUBLIC_APP_URL=http://localhost:8081
