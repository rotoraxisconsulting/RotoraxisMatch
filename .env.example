# ─────────────────────────────────────────────────────────────
# AviationJobTalent — Client environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Supabase project URL (found in Supabase Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable/anon key (same location as above)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# Public base URL used for Supabase auth redirect links (password reset, email confirmation).
# Development:  http://localhost:8081
# PRODUCTION:   change to your deployed web URL before going live
#               e.g. https://app.aviationjobtalent.com
EXPO_PUBLIC_APP_URL=http://localhost:8081

# ─────────────────────────────────────────────────────────────
# Local/server-only — NEVER used in client/app code, NEVER committed
# ─────────────────────────────────────────────────────────────

# Supabase service role key (Project Settings → API → service_role). Bypasses
# RLS. Only used by scripts/backfillLegacyAircraftRatings.ts, run locally or
# in a trusted server/CI context — never imported by anything under app/ or
# src/. Leave unset unless you need to run that script.
SUPABASE_SERVICE_ROLE_KEY=
